        {
          "text": "A "
        },
        {
          "text": "half subtractor",
          "marks": [
            {
              "kind": "bold"
            }
          ]
        },
        {
          "text": " computes "
        },
        {
          "text": "A - B",
          "marks": [
            {
              "kind": "code"
            }
          ]
        },
        {
          "text": " for two single bits, producing a "
        },
        {
          "text": "DIFFERENCE",
          "marks": [
            {
              "kind": "code"
            }
          ]
        },
        {
          "text": " and a "
        },
        {
          "text": "BORROW",
          "marks": [
            {
              "kind": "code"
            }
          ]
        },
        {
          "text": ". It mirrors the half adder almost exactly, with one revealing difference."
        }
      ]
    },
    {
