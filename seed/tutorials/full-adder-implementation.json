          "1",
          "1"
        ]
      ],
      "type": "table",
      "headers": [
        "A",
        "B",
        "CIN",
        "SUM",
        "COUT"
      ]
    },
    {
      "id": "h-gates",
      "text": "Building it from two half adders",
      "type": "heading",
      "level": 2
    },
    {
      "id": "h-first",
      "text": "First half adder",
      "type": "heading",
      "level": 3
    },
    {
      "id": "p-first",
      "type": "paragraph",
      "content": [
        {
          "text": "Add A and B. This gives a partial sum and a first carry."
        }
      ]
    },
    {
      "id": "h-second",
      "text": "Second half adder",
      "type": "heading",
      "level": 3
    },
    {
      "id": "p-second",
      "type": "paragraph",
      "content": [
        {
          "text": "Add that partial sum to CIN. This produces the final SUM and a second carry."
        }
      ]
    },
    {
      "id": "h-or",
      "text": "OR the two carries",
      "type": "heading",
      "level": 3
    },
    {
      "id": "p-or",
      "type": "paragraph",
      "content": [
        {
          "text": "A carry out happens if either half adder generated one. They can never both be 1, so a single OR gate combines them: "
        },
        {
          "text": "COUT = C1 OR C2",
          "marks": [
            {
              "kind": "code"
            }
          ]
        },
        {
          "text": "."
        }
      ]
    },
    {
      "id": "h-expression",
      "text": "The boolean expressions",
      "type": "heading",
      "level": 2
    },
    {
      "id": "p-expression",
      "type": "paragraph",
      "content": [
        {
          "text": "SUM = A XOR B XOR CIN",
          "marks": [
            {
              "kind": "code"
            }
          ]
        },
        {
          "text": "  and  "
        },
        {
          "text": "COUT = (A AND B) OR (CIN AND (A XOR B))",
          "marks": [
            {
              "kind": "code"
            }
          ]
        }
      ]
    },
    {
      "id": "h-chaining",
      "text": "Chaining full adders",
      "type": "heading",
      "level": 2
    },
    {
      "id": "p-chaining",
      "type": "paragraph",
      "content": [
        {
          "text": "Wire each adder's COUT into the next one's CIN and you have a "
        },
        {
          "text": "ripple-carry adder",
          "marks": [
            {
              "kind": "bold"
            }
          ]
        },
        {
          "text": ", the simplest way to add multi-bit numbers. The name comes from the carry having to ripple through every stage before the answer is final, which is what limits its speed."
        }
      ]
    },
    {
      "id": "h-build",
      "text": "Build it yourself",
      "type": "heading",
      "level": 2
    },
    {
      "id": "p-build",
      "type": "paragraph",
      "content": [
        {
          "text": "Start from two half adders rather than trying to wire all five gates at once."
        }
      ]
    },
