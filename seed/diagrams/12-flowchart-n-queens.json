      },
      {
        "id": "undo",
        "type": "process",
        "text": "remove queen\nfrom (row, col)",
        "accent": "coral",
        "parentId": "cycle",
        "note": "The board is one shared array. A queen left behind poisons every arrangement tried after this one."
      },
      {
        "id": "next",
