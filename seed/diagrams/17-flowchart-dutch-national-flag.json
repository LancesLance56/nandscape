      {
        "id": "start",
        "type": "start",
        "text": "sortColors(a)\nlow = 0, mid = 0\nhigh = a.length - 1"
      },
      {
        "id": "loop",
        "type": "decision",
        "text": "mid <= high ?"
      },
      {
        "id": "chk0",
        "type": "decision",
        "text": "a[mid] == 0 ?"
      },
      {
        "id": "chk2",
        "type": "decision",
        "text": "a[mid] == 2 ?",
        "note": "The three tests mirror the tutorial's code: first 0, then 2, and 1 is whatever is left. Order does not matter for correctness, only that every case is covered."
      },
      {
        "id": "do0",
        "type": "process",
        "text": "swap a[low], a[mid]\nlow += 1\nmid += 1",
        "accent": "green",
        "note": "A 0 belongs in the left region. Send it there, then step both low and mid, because everything behind mid is already in place."
      },
      {
        "id": "do1",
        "type": "process",
        "text": "mid += 1",
        "note": "a[mid] is a 1. It already sits in the middle region, so only mid moves."
      },
      {
        "id": "do2",
        "type": "process",
        "text": "swap a[mid], a[high]\nhigh -= 1",
        "accent": "coral",
        "badge": "!",
        "note": "A 2 belongs on the right. Swap it past high and shrink high. mid does NOT move: the value that just arrived from high has never been examined."
      },
      {
        "id": "done",
        "type": "end",
        "text": "return a\n[0, low) = 0s\n[low, mid) = 1s\n(high, end] = 2s"
      }
    ],
    "edges": [
