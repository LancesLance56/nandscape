  "title": "Lomuto partition",
  "group": "Sorting",
  "position": 6,
  "spec": {
    "title": "Lomuto partition",
    "direction": "LR",
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "text": "partition(a, low, high)"
      },
      {
        "id": "init",
        "type": "process",
        "text": "pivot = a[high]\ni = low - 1\nj = low",
        "note": "i marks the end of the 'smaller than pivot' region, which starts empty. That is why it starts one before the range rather than at it."
      },
      {
        "id": "loop",
        "type": "decision",
        "text": "j < high ?"
      },
      {
        "id": "cmp",
        "type": "decision",
        "text": "a[j] < pivot ?"
      },
      {
        "id": "grow",
        "type": "process",
        "text": "i = i + 1\nswap a[i], a[j]",
        "accent": "blue",
        "note": "Grow the smaller region by one and move this element into it. The value displaced was known to be >= pivot, so it lands correctly on the other side."
      },
      {
        "id": "inc",
        "type": "process",
        "text": "j = j + 1"
      },
      {
        "id": "final",
        "type": "process",
        "text": "swap a[i+1], a[high]",
        "accent": "blue",
        "badge": "!",
        "note": "Drop the pivot onto the boundary between the two regions. This is the step that makes a[i+1] permanent."
      },
      {
        "id": "end",
        "type": "end",
        "text": "return i + 1"
      }
    ],
    "edges": [
      {
        "id": "p1",
        "from": "start",
        "to": "init"
      },
      {
        "id": "p2",
        "from": "init",
        "to": "loop"
      },
      {
        "id": "p3",
        "from": "loop",
        "to": "cmp",
        "label": "yes"
      },
      {
        "id": "p4",
        "from": "loop",
        "to": "final",
        "label": "no"
      },
      {
        "id": "p5",
        "from": "cmp",
        "to": "grow",
        "label": "yes"
      },
      {
        "id": "p6",
        "from": "cmp",
        "to": "inc",
        "label": "no"
      },
      {
        "id": "p7",
        "from": "grow",
        "to": "inc"
      },
      {
        "id": "p8",
        "from": "inc",
        "to": "loop"
      },
      {
        "id": "p9",
        "from": "final",
        "to": "end"
      }
    ],
    "walkthrough": [
      {
        "node": "start",
        "caption": "Partitioning [7, 2, 4, 6] with low = 0 and high = 3."
      },
      {
        "node": "init",
        "caption": "pivot = a[3] = 6. i = -1 because the 'smaller' region is empty. j = 0."
      },
      {
        "node": "loop",
        "caption": "j < high, that is 0 < 3 ? Yes."
      },
      {
        "node": "cmp",
        "caption": "a[0] = 7. Is 7 < 6 ? No, so it belongs on the far side. Leave it."
      },
      {
        "node": "inc",
        "caption": "j = 1. Nothing moved."
      },
      {
        "node": "loop",
        "caption": "1 < 3 ? Yes."
      },
      {
        "node": "cmp",
        "caption": "a[1] = 2. Is 2 < 6 ? Yes, it belongs in the smaller region."
      },
      {
        "node": "grow",
        "caption": "i becomes 0, swap a[0] and a[1]. The array is now [2, 7, 4, 6]."
      },
      {
        "node": "inc",
        "caption": "j = 2."
      },
      {
        "node": "loop",
        "caption": "2 < 3 ? Yes."
      },
      {
        "node": "cmp",
        "caption": "a[2] = 4. Is 4 < 6 ? Yes."
      },
      {
        "node": "grow",
        "caption": "i becomes 1, swap a[1] and a[2]. The array is now [2, 4, 7, 6]."
      },
      {
        "node": "inc",
        "caption": "j = 3."
      },
      {
        "node": "loop",
        "caption": "3 < 3 ? No. The scan is finished, and i = 1 marks the end of the smaller region."
      },
      {
        "node": "final",
        "caption": "Swap a[i+1] = a[2] with the pivot at a[3]. The array is [2, 4, 6, 7]."
      },
      {
        "node": "end",
        "caption": "Return 2. a[2] = 6 is now permanently correct, with smaller left and larger right."
      }
    ],
    "interactive": {
      "walkthrough": true
    }
  }
}
