        "label": "yes"
      },
      {
        "from": "outer",
        "to": "end",
        "label": "no"
      },
      {
        "from": "setmin",
        "to": "inner"
      },
      {
        "from": "inner",
        "to": "cmp",
        "label": "yes"
      },
      {
        "from": "inner",
        "to": "swap",
        "label": "no"
      },
      {
        "from": "cmp",
        "to": "newmin",
        "label": "yes"
      },
      {
