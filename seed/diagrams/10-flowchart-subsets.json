        "walkthrough": [
          {
            "id": "wmtpkp5jz51",
            "target": "start",
            "caption": "Generating subsets of [a, b]. This is the outermost call: start = 0, current = []."
          },
          {
            "id": "wmtpkp5jz52",
            "target": "record",
            "caption": "Record a copy of current, which is the empty set. Yes, that counts as a subset."
          },
          {
            "id": "wmtpkp5jz53",
            "target": "init",
            "caption": "i = start = 0."
          },
          {
            "id": "wmtpkp5jz54",
            "target": "loop",
            "caption": "i < n, that is 0 < 2 ? Yes."
          },
          {
            "id": "wmtpkp5jz55",
            "target": "choose",
            "caption": "Push a[0] = a. current is now [a]."
          },
          {
            "id": "wmtpkp5jz56",
            "target": "explore",
            "caption": "Recurse with start = 1. That call records [a], then goes on to record [a, b] before returning."
          },
          {
            "id": "wmtpkp5jz57",
            "target": "undo",
            "caption": "Pop. current is back to [], exactly as it was before this choice was made."
          },
          {
            "id": "wmtpkp5jz58",
            "target": "next",
            "caption": "i = 1."
          },
          {
            "id": "wmtpkp5jz59",
            "target": "loop",
            "caption": "1 < 2 ? Yes, there is still a choice left at this level."
          },
          {
            "id": "wmtpkp5jz5a",
            "target": "choose",
            "caption": "Push a[1] = b. current is now [b]."
          },
          {
            "id": "wmtpkp5jz5b",
            "target": "explore",
            "caption": "Recurse with start = 2. That call records [b] and finds no further choices. Note it never produces [b, a]: start has moved past a."
          },
          {
            "id": "wmtpkp5jz5c",
            "target": "undo",
            "caption": "Pop. current is [] again."
          },
          {
            "id": "wmtpkp5jz5d",
            "target": "next",
            "caption": "i = 2."
          },
          {
            "id": "wmtpkp5jz5e",
            "target": "loop",
            "caption": "2 < 2 ? No. Out of choices."
          },
          {
            "id": "wmtpkp5jz5f",
            "target": "ret",
            "caption": "Return. Four subsets recorded: [], [a], [a, b], [b]. That is 2^2, as promised."
          }
        ]
