  "title": "The converging two-pointer template",
  "group": "Two pointers",
  "position": 0,
  "spec": {
    "title": "The converging two-pointer template",
    "direction": "LR",
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "text": "solve(a, target)\nlo = 0\nhi = a.length - 1",
        "note": "The array has to be sorted, or ordered by whatever quantity the comparison below is about. Sorting is what makes the two eliminations valid."
      },
      {
        "id": "loop",
        "type": "decision",
        "text": "lo < hi ?",
        "note": "The loop runs while the pointers have not met. Each iteration moves exactly one of them, so at most n iterations happen in total."
      },
      {
        "id": "measure",
        "type": "process",
        "text": "s = a[lo] + a[hi]",
        "note": "Whatever the problem measures about the current pair: a sum, an area, a distance."
      },
      {
        "id": "cmp",
        "type": "decision",
        "text": "compare s\nto target",
        "badge": "1",
        "accent": "amber",
        "note": "The only place a decision is made. Everything else in the template is bookkeeping."
      },
      {
        "id": "hit",
        "type": "process",
        "text": "record the pair\nlo += 1, hi -= 1",
        "accent": "green",
        "note": "A match. Both pointers move, because keeping either one fixed can only re-find the same pair."
      },
      {
        "id": "low",
        "type": "process",
        "text": "lo += 1",
        "accent": "blue",
        "badge": "2",
        "note": "Too small. a[hi] is already the largest value left, so no partner can rescue a[lo]: it is eliminated against every remaining candidate at once, not just against a[hi]."
      },
      {
        "id": "high",
        "type": "process",
        "text": "hi -= 1",
        "accent": "coral",
        "badge": "3",
        "note": "Too big. a[lo] is already the smallest value left, so a[hi] is too large for every remaining partner."
      },
      {
        "id": "done",
        "type": "end",
        "text": "return the answer\n(pointers met)",
        "note": "Every index was visited at most once by each pointer, so the pass is O(n)."
      }
    ],
