          {
            "id": "wmtpkp5j4f",
            "target": "start",
            "caption": "Sorting [5, 1, 4]. Three elements, so n = 3."
          },
          {
            "id": "wmtpkp5j4g",
            "target": "init",
            "caption": "pass = 0. The outer loop will run at most n-1 = 2 times."
          },
          {
            "id": "wmtpkp5j4h",
            "target": "outer",
            "caption": "pass < 2 ? Yes, so start a pass."
          },
          {
            "id": "wmtpkp5j4i",
            "target": "reset",
            "caption": "i = 0, swapped = false. Every pass starts by forgetting what the last one did."
          },
          {
            "id": "wmtpkp5j4j",
            "target": "inner",
            "caption": "i < n-1-pass, that is 0 < 2 ? Yes."
          },
          {
            "id": "wmtpkp5j4k",
            "target": "cmp",
            "caption": "a[0] = 5, a[1] = 1. Is 5 > 1 ? Yes, they are out of order."
          },
          {
            "id": "wmtpkp5j4l",
            "target": "swap",
            "caption": "Swap them. The array is now [1, 5, 4] and swapped = true."
          },
          {
            "id": "wmtpkp5j4m",
            "target": "inc-i",
            "caption": "i = 1."
          },
          {
            "id": "wmtpkp5j4n",
            "target": "inner",
            "caption": "1 < 2 ? Yes, keep going."
          },
          {
            "id": "wmtpkp5j4o",
            "target": "cmp",
            "caption": "a[1] = 5, a[2] = 4. Is 5 > 4 ? Yes."
          },
          {
            "id": "wmtpkp5j4p",
            "target": "swap",
            "caption": "Swap. The array is [1, 4, 5]. The largest value has bubbled to the end."
          },
          {
            "id": "wmtpkp5j4q",
            "target": "inc-i",
            "caption": "i = 2."
          },
          {
            "id": "wmtpkp5j4r",
            "target": "inner",
            "caption": "2 < 2 ? No. This pass is over."
          },
          {
            "id": "wmtpkp5j4s",
            "target": "check",
            "caption": "swapped ? Yes, this pass moved things, so the array might still be unsorted."
          },
          {
            "id": "wmtpkp5j4t",
            "target": "inc-pass",
            "caption": "pass = 1."
          },
          {
            "id": "wmtpkp5j4u",
            "target": "outer",
            "caption": "1 < 2 ? Yes, one more pass."
          },
          {
            "id": "wmtpkp5j4v",
            "target": "reset",
            "caption": "i = 0, swapped = false again."
          },
          {
            "id": "wmtpkp5j4w",
            "target": "inner",
            "caption": "i < n-1-pass is 0 < 1 ? Yes. Note the range shrank: a[2] is already final."
