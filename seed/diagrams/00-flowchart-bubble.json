{
  "slug": "bubble",
  "kind": "flowchart",
  "title": "Bubble sort",
  "group": "Sorting",
  "position": 0,
  "spec": {
    "title": "Bubble sort",
    "direction": "LR",
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "text": "Start"
      },
      {
        "id": "init",
        "type": "process",
        "text": "pass = 0",
        "note": "One pass per element, minus one."
      },
      {
        "id": "outer",
        "type": "decision",
        "text": "pass < n-1 ?"
      },
      {
        "id": "reset",
        "type": "process",
        "text": "i = 0\nswapped = false",
        "note": "swapped is what allows the early exit. Clearing it at the top of every pass is what makes it mean 'did anything move during this pass', rather than 'ever'."
      },
      {
        "id": "inner",
        "type": "decision",
        "text": "i < n-1-pass ?",
        "note": "The tail is already sorted, so each pass looks at one fewer element."
      },
      {
        "id": "cmp",
        "type": "decision",
        "text": "a[i] > a[i+1] ?"
      },
      {
        "id": "swap",
        "type": "process",
        "text": "swap a[i], a[i+1]\nswapped = true",
        "accent": "blue",
        "note": "The only step that moves data. Everything else in this chart is bookkeeping around it."
      },
      {
        "id": "inc-i",
        "type": "process",
        "text": "i = i + 1"
      },
      {
        "id": "check",
        "type": "decision",
        "text": "swapped ?",
        "accent": "amber",
        "badge": "!",
        "note": "A whole pass with no swaps means the array is already ordered, so the remaining passes would all do nothing. This one test is what makes bubble sort O(n) on sorted input."
      },
      {
        "id": "inc-pass",
        "type": "process",
        "text": "pass = pass + 1"
      },
      {
        "id": "end",
        "type": "end",
        "text": "Sorted"
      }
    ],
    "edges": [
