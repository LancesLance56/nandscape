{
  "slug": "half-subtractor",
  "title": "Half Subtractor",
  "description": "Subtract B from A for a single bit, producing DIFF and a BORROW flag when B is bigger than A.",
  "difficulty": "easy",
  "tags": ["combinational", "arithmetic"],
  "gateBudget": 4,
  "inputs": [{ "name": "A" }, { "name": "B" }],
  "outputs": [{ "name": "DIFF" }, { "name": "BORROW" }],
  "testCases": [
    { "row": { "inputs": { "A": 0, "B": 0 }, "outputs": { "DIFF": 0, "BORROW": 0 } } },
    { "row": { "inputs": { "A": 0, "B": 1 }, "outputs": { "DIFF": 1, "BORROW": 1 } } },
    { "row": { "inputs": { "A": 1, "B": 0 }, "outputs": { "DIFF": 1, "BORROW": 0 } } },
    { "row": { "inputs": { "A": 1, "B": 1 }, "outputs": { "DIFF": 0, "BORROW": 0 } } }
  ]
}
