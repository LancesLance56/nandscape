          "setInputs": {
            "RESET": 1
          },
          "expectOutputs": {
            "Q0": 0,
            "Q1": 0,
            "Q2": 0,
            "Q3": 0
          }
        },
        {
          "setInputs": {
            "CLK": 0,
            "SIN": 1,
            "RESET": 0
          },
          "expectOutputs": {
            "Q0": 0,
            "Q1": 0,
            "Q2": 0,
            "Q3": 0
          }
        },
