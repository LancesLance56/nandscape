  "disallowedGateTypes": [5],
  "inputs": [{ "name": "A" }, { "name": "B" }],
  "outputs": [{ "name": "EQ" }],
  "testCases": [
    { "row": { "inputs": { "A": 0, "B": 0 }, "outputs": { "EQ": 1 } } },
    { "row": { "inputs": { "A": 0, "B": 1 }, "outputs": { "EQ": 0 } } },
    { "row": { "inputs": { "A": 1, "B": 0 }, "outputs": { "EQ": 0 } } },
    { "row": { "inputs": { "A": 1, "B": 1 }, "outputs": { "EQ": 1 } } }
