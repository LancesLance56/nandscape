  "testCases": [
    { "row": { "inputs": { "A": 0, "B": 0 }, "outputs": { "LT": 0, "EQ": 1, "GT": 0 } } },
    { "row": { "inputs": { "A": 0, "B": 1 }, "outputs": { "LT": 1, "EQ": 0, "GT": 0 } } },
    { "row": { "inputs": { "A": 1, "B": 0 }, "outputs": { "LT": 0, "EQ": 0, "GT": 1 } } },
    { "row": { "inputs": { "A": 1, "B": 1 }, "outputs": { "LT": 0, "EQ": 1, "GT": 0 } } }
