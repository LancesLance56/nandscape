{
  "slug": "sop-tree-and-or",
  "title": "Sum-of-Products Warm-Up",
  "description": "Output HIGH when A and B are both HIGH, or when B and C are both HIGH. B is shared between the two terms.",
  "difficulty": "easy",
  "tags": ["combinational", "boolean-algebra"],
  "gateBudget": 3,
  "inputs": [{ "name": "A" }, { "name": "B" }, { "name": "C" }],
  "outputs": [{ "name": "Y" }],
  "testCases": [
    { "row": { "inputs": { "A": 0, "B": 0, "C": 0 }, "outputs": { "Y": 0 } } },
    { "row": { "inputs": { "A": 0, "B": 0, "C": 1 }, "outputs": { "Y": 0 } } },
    { "row": { "inputs": { "A": 0, "B": 1, "C": 0 }, "outputs": { "Y": 0 } } },
    { "row": { "inputs": { "A": 0, "B": 1, "C": 1 }, "outputs": { "Y": 1 } } },
    { "row": { "inputs": { "A": 1, "B": 0, "C": 0 }, "outputs": { "Y": 0 } } },
    { "row": { "inputs": { "A": 1, "B": 0, "C": 1 }, "outputs": { "Y": 0 } } },
    { "row": { "inputs": { "A": 1, "B": 1, "C": 0 }, "outputs": { "Y": 1 } } },
    { "row": { "inputs": { "A": 1, "B": 1, "C": 1 }, "outputs": { "Y": 1 } } }
  ]
}
