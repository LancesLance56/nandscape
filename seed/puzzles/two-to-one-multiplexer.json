  "outputs": [{ "name": "Y" }],
  "testCases": [
    { "row": { "inputs": { "SEL": 0, "A": 0, "B": 0 }, "outputs": { "Y": 0 } } },
    { "row": { "inputs": { "SEL": 0, "A": 0, "B": 1 }, "outputs": { "Y": 0 } } },
    { "row": { "inputs": { "SEL": 0, "A": 1, "B": 0 }, "outputs": { "Y": 1 } } },
    { "row": { "inputs": { "SEL": 0, "A": 1, "B": 1 }, "outputs": { "Y": 1 } } },
    { "row": { "inputs": { "SEL": 1, "A": 0, "B": 0 }, "outputs": { "Y": 0 } } },
    { "row": { "inputs": { "SEL": 1, "A": 0, "B": 1 }, "outputs": { "Y": 1 } } },
    { "row": { "inputs": { "SEL": 1, "A": 1, "B": 0 }, "outputs": { "Y": 0 } } },
    { "row": { "inputs": { "SEL": 1, "A": 1, "B": 1 }, "outputs": { "Y": 1 } } }
  ]
