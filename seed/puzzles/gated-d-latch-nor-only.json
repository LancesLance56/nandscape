{
  "slug": "gated-d-latch-nor-only",
  "title": "Gated D Latch (NOR only)",
  "description": "Build a transparent, enable-gated D latch using only NOR gates. Derive AND, OR, and NOT from NOR first, then build the latch.",
  "difficulty": "hard",
  "tags": [
    "sequential",
    "memory"
  ],
  "gateBudget": 15,
  "allowedGateTypes": [
    3
  ],
  "inputs": [
    {
      "name": "D",
      "defaultValue": 0
    },
    {
      "name": "E",
      "defaultValue": 0
    }
  ],
  "outputs": [
    {
      "name": "Q"
    },
    {
      "name": "QN"
    }
  ],
  "testCases": [
    {
      "sequence": [
        {
          "setInputs": {
            "D": 1,
            "E": 1
          },
          "expectOutputs": {
            "Q": 1,
            "QN": 0
          }
        },
        {
          "setInputs": {
            "D": 0,
            "E": 1
          },
          "expectOutputs": {
            "Q": 0,
            "QN": 1
          }
        },
        {
          "setInputs": {
            "E": 0
          },
          "expectOutputs": {
            "Q": 0,
            "QN": 1
          }
        },
        {
          "setInputs": {
            "D": 1
          },
          "expectOutputs": {
            "Q": 0,
            "QN": 1
          }
        },
        {
          "setInputs": {
            "E": 1
          },
          "expectOutputs": {
            "Q": 1,
            "QN": 0
          }
        }
      ]
    }
  ]
}
