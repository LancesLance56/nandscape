POSTGRES_PASSWORD=LancesLance56

WEB_PORT=3000

DATABASE_URL=postgres://nandscape:LancesLance56@localhost:5432/app_db

ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Public URL of the site - used to build the Google OAuth redirect URI
# (${SITE_URL}/api/auth/google/callback), which must exactly match an
# "Authorized redirect URI" on the OAuth client in Google Cloud Console.
SITE_URL=https://nandscape.dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Used to send signup email-verification links (see packages/auth/src/email.ts).
# Without it, verification links are just logged to the server console instead
# of actually emailed,  fine for local dev, not for production.
RESEND_API_KEY=
EMAIL_FROM=Nandscape <onboarding@resend.dev>
