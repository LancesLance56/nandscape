generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  username                String                   @unique
  passwordHash            String?
  googleId                String?                  @unique
  /**
   * Null until the address is confirmed via the emailed verification link
   * (or, for Google sign-in, immediately set at creation when Google
   * already reports the address verified - see findOrCreateGoogleUser).
   */
  emailVerifiedAt         DateTime?
  name                    String?
  avatarUrl               String?
  role                    Role                     @default(USER)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  puzzles                 Puzzle[]
  puzzleAttempts          PuzzleAttempt[]
  puzzleProgress          PuzzleProgress[]
  sessions                Session[]
  projects                Project[]
  emailVerificationTokens EmailVerificationToken[]
  tutorialProgress        TutorialProgress[]
  quizAttempts            QuizAttempt[]
  preference              UserPreference?
  codingProblems          CodingProblem[]
  codingSubmissions       CodingSubmission[]
  codingDrafts            CodingDraft[]

  @@index([email])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BlogPost {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String    @unique
  title          String
  excerpt        String?
  coverImage     String?   @map("cover_image")
  authorName     String?   @map("author_name")
  status         String    @default("draft")
  body           Json      @default("[]")
  tags           String[]  @default([])
  /**
   * The <title> tag, which wants ~50-60 characters and the target keyword
   * near the front - a different job from `title`, the on-page H1, which is
   * written for a reader already on the page. Null falls back to `title`.
   */
  seoTitle       String?   @map("seo_title")
  /**
   * The meta description (~150-160 chars). Distinct from `excerpt`, which
   * is card/listing copy; this one is written to earn the click from a
   * search result. Null falls back to `excerpt`.
   */
  seoDescription String?   @map("seo_description")
  /**
   * Target search keywords, most important first. Not emitted as the
   * long-dead <meta keywords> tag - it's editorial intent, used to keep
   * headings/copy honest and to fill schema.org `keywords`.
   */
  keywords       String[]  @default([])
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([publishedAt(sort: Desc)], map: "idx_blog_posts_published_at")
  @@map("blog_posts")
}

/**
 * The top level of the tutorial library: a broad subject area ("Digital
 * Logic", "Data Structures & Algorithms") that owns several sections, each
 * of which owns its pages. Sections existed first and were flat, so
 * `trackId` is nullable - an untracked section still renders, it just sits
 * outside the directory listing rather than breaking it.
 */
model TutorialTrack {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String            @unique
  title       String
  description String?
  position    Int               @default(0)
  sections    TutorialSection[]

  @@map("tutorial_tracks")
}

model TutorialSection {
  id       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug     String         @unique
  title    String
  position Int            @default(0)
  trackId  String?        @map("track_id") @db.Uuid
  track    TutorialTrack? @relation(fields: [trackId], references: [id], onDelete: SetNull)
  pages    TutorialPage[]

  @@index([trackId, position])
  @@map("tutorial_sections")
}

model TutorialPage {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String           @unique
  title          String
  excerpt        String?
  coverImage     String?          @map("cover_image")
  authorName     String?          @map("author_name")
  status         String           @default("draft")
  body           Json             @default("[]")
  tags           String[]         @default([])
  /**
   * See the matching fields on BlogPost for what each is for.
   */
  seoTitle       String?          @map("seo_title")
  seoDescription String?          @map("seo_description")
  keywords       String[]         @default([])
  position       Int              @default(0)
  sectionId      String?          @map("section_id") @db.Uuid
  section        TutorialSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  publishedAt    DateTime?        @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([sectionId, position])
  @@map("tutorial_pages")
}

model Puzzle {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  description String?
  difficulty  Difficulty      @default(MEDIUM)
  data        Json
  solution    Json
  creatorId   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  creator     User?           @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  attempts    PuzzleAttempt[]

  @@index([creatorId])
  @@index([difficulty])
}

model PuzzleAttempt {
  id            String   @id @default(cuid())
  userId        String
  puzzleId      String
  solved        Boolean  @default(false)
  attemptsCount Int      @default(1)
  timeTakenMs   Int?
  submittedAt   DateTime @default(now())
  puzzle        Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([puzzleId])
}

model PuzzleProgress {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String
  puzzleSlug String    @map("puzzle_slug")
  solved     Boolean   @default(false)
  solvedAt   DateTime? @map("solved_at") @db.Timestamptz(6)
  nodes      Json      @default("[]")
  edges      Json      @default("[]")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, puzzleSlug])
  @@index([userId])
  @@map("puzzle_progress")
}

model Project {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         String
  description  String?
  /**
   * `nodes`/`edges` always mirror `scopes[0]` (the project's first tab), so
   * every reader that predates tabs - embeds, thumbnails, the sitemap -
   * keeps working unchanged against a single flat circuit.
   */
  nodes        Json              @default("[]")
  edges        Json              @default("[]")
  /**
   * Every tab (CircuitVerse calls these "scopes") in this project. Any tab
   * can be dropped into another as a subcircuit instance - see
   * apps/web/types/scope.ts and apps/web/store/scopes-store.ts.
   */
  scopes       Json              @default("[]")
  /**
   * Snapshot of every non-builtin custom block this project's subcircuit
   * nodes reference (transitively), so the project stays self-contained
   * regardless of what's in any particular browser's local block library
   * - see apps/web/lib/editor/subcircuit-flatten.ts's resolveBlockClosure,
   * which computes this at save time.
   */
  blocks       Json              @default("[]")
  /**
   * Freeform, owner- or seed-set (e.g. "tutorial" marks a tutorial's
   * companion circuit - see FeaturedCircuit's doc comment for the parallel
   * curated-pick concept). Drives the community page's filter chips and
   * its "From the Tutorials" section.
   */
  tags         String[]          @default([])
  visibility   ProjectVisibility @default(PRIVATE)
  ownerId      String            @map("owner_id")
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  forkedFromId String?           @map("forked_from_id")
  forkedFrom   Project?          @relation("ProjectForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks        Project[]         @relation("ProjectForks")
  featuredIn   FeaturedCircuit[]
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([visibility])
  @@map("projects")
}

enum ProjectVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

/**
 * Admin-curated candidates for the homepage's live-demo embed (see
 * apps/web/components/marketing/live-demo.tsx) - marketing can add several
 * projects here over time and switch which one is live without touching
 * code. At most one row should have `active = true` at a time; that's
 * enforced at the application layer (see featured-circuits.ts's
 * setActiveFeaturedCircuit, a single atomic UPDATE that sets every row's
 * `active` from an `id = $1` comparison), not a DB constraint, matching how
 * simple admin toggles are handled elsewhere in this codebase.
 */
/**
 * `placement` scopes the "exactly one active row" invariant: setting one
 * HOMEPAGE_DEMO row active never touches a COMMUNITY_WEEKLY row's active
 * state, and vice versa - two independent admin-curated single-picks
 * sharing one table and one UI pattern, see
 * lib/featured-circuits/featured-circuits.ts's setActiveFeaturedCircuit.
 */
enum FeaturedPlacement {
  HOMEPAGE_DEMO
  COMMUNITY_WEEKLY
}

model FeaturedCircuit {
  id        String            @id @default(cuid())
  projectId String            @map("project_id")
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  placement FeaturedPlacement @default(HOMEPAGE_DEMO)
  active    Boolean           @default(false)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([placement, active])
  @@map("featured_circuits")
}

/// A named diagram that content refers to by slug rather than embedding.
///
/// Flowcharts and the worked examples the graph widgets ship with used to be
/// TypeScript literals compiled into the bundle, which meant a typo in a
/// teaching diagram was a code change and a deploy. They live here instead:
/// `spec` is the same JSON shape the widgets already accept inline, so a
/// block can either name one of these or carry its own.
model DiagramPreset {
  id       String  @id @default(cuid())
  slug     String  @unique
  /// Which widget family reads this: "flowchart" or "graph".
  kind     String
  title    String
  /// Optional heading for the editor's picker, e.g. "Sorting".
  group    String?
  /// Order within a group in that picker.
  position Int     @default(0)
  /// A FlowchartSpec or GraphSpec, exactly as the widget consumes it.
  spec     Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kind, group, position])
  @@map("diagram_presets")
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

/// What a clap or a completion is attached to. Slugs rather than foreign keys
/// because tutorial pages and blog posts are addressed by slug everywhere else
/// in the app, and a clap should survive a post being re-seeded (which is a
/// delete plus an insert, and so a new id).
enum ContentKind {
  BLOG
  TUTORIAL
}

/// Medium-style applause, countable and available to signed-out readers.
///
/// `clapperId` is either `user:<id>` or `anon:<random>`; collapsing both into
/// one column keeps this to a single unique constraint, where a nullable
/// userId would not (Postgres treats NULLs as distinct, so a nullable column
/// in a unique index stops preventing duplicates for exactly the anonymous
/// rows that need it most).
model Clap {
  id         String      @id @default(cuid())
  targetKind ContentKind
  targetSlug String
  clapperId  String
  /// Per-clapper tally, capped in application code. One row per clapper per
  /// thing, incremented in place, so the total is a SUM rather than a count of
  /// rows.
  count      Int         @default(1)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@unique([targetKind, targetSlug, clapperId])
  @@index([targetKind, targetSlug])
  @@map("claps")
}

/// A tutorial page a signed-in reader has marked done.
///
/// Rows only exist for completed pages: "not started" is the absence of a row,
/// so nothing has to be backfilled when a new lesson is published.
model TutorialProgress {
  id          String   @id @default(cuid())
  userId      String
  pageSlug    String   @map("page_slug")
  /// Denormalised so the dashboard can group by track without joining through
  /// TutorialPage, which resolves its parent by slug rather than by id.
  trackSlug   String?  @map("track_slug")
  completedAt DateTime @default(now()) @map("completed_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pageSlug])
  @@index([userId])
  @@map("tutorial_progress")
}

/// One finished run of a quiz widget, kept per attempt rather than as a single
/// best score so the activity heatmap has something dated to plot.
model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  /// `<pageSlug>:<widgetId>` - quizzes are blocks inside a page, so neither
  /// half identifies one on its own.
  quizKey   String   @map("quiz_key")
  score     Int
  total     Int
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, quizKey])
  @@index([userId, createdAt])
  @@map("quiz_attempts")
}

/// Per-user dashboard settings: the knobs that make /account personal rather
/// than identical for everyone.
///
/// A separate table rather than columns on User because none of it is identity.
/// User is read on every authenticated request to build the session; these
/// fields are read by one page, and they will keep growing as the dashboard
/// does. The row is created lazily on first save, so `null` here means
/// "defaults", not "broken" - see lib/account/preferences.ts.
model UserPreference {
  /// Also the primary key: exactly one row per user, so there is no way to end
  /// up with two competing preference sets and no need for a uniqueness rule
  /// beyond the one the PK already gives.
  userId String @id

  /// Slug of the TutorialTrack the reader is working through right now. Drives
  /// the "continue where you left off" card and the goal ring's denominator.
  /// A slug rather than an FK because tracks are re-seeded (delete + insert, so
  /// a new id) and a focus should survive that, matching how TutorialProgress
  /// already stores trackSlug.
  focusTrackSlug String? @map("focus_track_slug")

  /// Lessons + quizzes the reader is aiming to finish in a week. Clamped in
  /// application code to 1-20; zero would make the ring divide by zero and the
  /// goal meaningless.
  weeklyGoal Int @default(3) @map("weekly_goal")

  /// Which difficulty to suggest unsolved puzzles from. Null = no preference,
  /// so recommendations span everything.
  preferredDifficulty Difficulty? @map("preferred_difficulty")

  /// Project ids the reader pinned to the top of their dashboard. Ids, not
  /// slugs: renaming a circuit rewrites its slug, and a pin should follow the
  /// circuit rather than quietly detaching.
  pinnedProjectIds String[] @default([]) @map("pinned_project_ids")

  /// Ids of the overview cards this reader has hidden. Storing what is *off*
  /// rather than what is on means a newly added card shows up for everyone by
  /// default instead of staying invisible until they opt in.
  hiddenWidgets String[] @default([]) @map("hidden_widgets")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// A coding practice problem: the user implements one function, and a
/// per-language driver calls it with JSON-encoded arguments (see
/// apps/web/lib/practice/languages.ts).
///
/// Shaped after Puzzle - slug-addressed, Json payloads, a nullable creator so
/// seeded content needs no author - with one deliberate divergence: the
/// hidden test cases and the reference solutions live in their own columns
/// rather than sharing one `solution` blob. A stray `SELECT *` in a
/// client-facing query then leaks nothing, because the secret columns are
/// named and can be omitted structurally instead of relying on every caller
/// remembering to strip them.
model CodingProblem {
  id         String     @id @default(cuid())
  slug       String     @unique
  title      String
  /// One-line summary for the list page. The full statement is `body`.
  summary    String?
  difficulty Difficulty @default(MEDIUM)
  tags       String[]   @default([])

  /// The problem statement, as Markdown.
  ///
  /// Deliberately *not* the ContentBlock[] array BlogPost.body and
  /// TutorialPage.body use. Those exist so a non-technical author can build a
  /// page from typed widgets, but a problem statement is written by whoever
  /// wrote the problem, and its shape is theirs to choose: which headings it
  /// has, whether constraints are a list or a table, where the worked example
  /// sits. A block array makes that a schema question; Markdown makes it a
  /// writing one. Fenced code inside is highlighted by the same Shiki contract
  /// as the rest of the site (lib/shiki-code.ts).
  statement String @default("")

  /// "function" today. Reserved so class-style design problems (a method-call
  /// sequence against an object, LeetCode's LRU-cache shape) can be added as a
  /// second driver mode rather than a migration.
  kind String @default("function")

  /// Language-neutral description of what the user implements:
  /// `{ name, params: [{ name, type }], returns }`, where each type is drawn
  /// from the ValueType vocabulary in apps/web/types/practice.ts.
  ///
  /// Python and JavaScript drivers ignore the types (both parse JSON into
  /// native values), but they are recorded from day one because a statically
  /// typed driver - C++ is the intended next language - has to generate a
  /// typed `main()` from exactly this. Adding that language is then a new
  /// LanguageDefinition, with no change to this table.
  signature Json

  /// Language ids this problem can be attempted in, and the stub each starts
  /// from: `{ python: "def two_sum(nums, target):\n    pass" }`. A language
  /// missing from `starterCode` is not offered, even if listed here.
  languages   String[] @default([])
  starterCode Json     @default("{}")

  /// `[{ args: [...], expected: <json>, explanation?: string }]`.
  ///
  /// Visible cases are shown in the statement and are the only ones "Run"
  /// executes. Hidden cases run on submit only, and their `args`/`expected`
  /// never leave the server - the client sees an index and a pass/fail.
  visibleTests Json @default("[]")
  hiddenTests  Json @default("[]")

  /// How a returned value is judged against `expected`: "exact",
  /// "unordered" (same multiset, any order), or "float" (within epsilon).
  compareMode String @default("exact")
  /// Tolerance for compareMode "float". Ignored otherwise.
  epsilon     Float  @default(0.000001)

  /// Per-test-case ceilings handed to the execution engine. Clamped against
  /// the hard maximums in apps/web/lib/practice/limits.ts, which are the real
  /// guarantee - these only ever tighten them, never loosen.
  timeLimitMs   Int @default(2000)
  memoryLimitMb Int @default(256)

  /// Reference implementations keyed by language, for the author's benefit
  /// only. Never selected by any client-facing query - see
  /// PUBLIC_COLUMNS in apps/web/lib/practice/practice-records.ts.
  solutions Json @default("{}")

  creatorId   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  creator     User?              @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  submissions CodingSubmission[]

  @@index([creatorId])
  @@index([difficulty])
}

/// One row per Submit press. Append-only, unlike PuzzleAttempt's upserted
/// counter: a coding problem is something you converge on over several tries,
/// and the history of those tries is worth showing back to the user. Solved
/// status for the list page is a groupBy over ACCEPTED rows rather than a
/// denormalized flag that could drift.
model CodingSubmission {
  id        String @id @default(cuid())
  userId    String
  problemId String
  language  String
  code      String

  verdict     SubmissionVerdict
  passedCount Int               @default(0)
  totalCount  Int               @default(0)

  /// Per-case outcomes. Entries for hidden cases carry the index and status
  /// but never the inputs or the expected value.
  results Json @default("[]")

  /// Slowest single test case, in wall-clock milliseconds. Null when the
  /// submission never ran (a compile error, or the engine being unreachable).
  /// There is deliberately no memory column: the engine reports no
  /// trustworthy peak-RSS figure, and a fabricated number reads as real.
  runtimeMs Int?

  submittedAt DateTime      @default(now())
  problem     CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([problemId])
  @@index([userId, problemId])
}

/// Unsubmitted work in progress, mirroring PuzzleProgress's "last state per
/// user" pattern - slug-addressed for the same reason, so re-seeding a
/// problem (a delete plus an insert, and so a new id) does not throw away
/// everyone's draft.
///
/// Keyed by language as well as problem: switching the picker to peek at the
/// JavaScript stub must not destroy the half-written Python.
model CodingDraft {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String
  problemSlug String   @map("problem_slug")
  language    String
  code        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemSlug, language])
  @@index([userId])
  @@map("coding_drafts")
}

/// Why a submission ended. WRONG_ANSWER means the code ran to completion and
/// returned something incorrect; every other non-ACCEPTED value means it never
/// got that far. The UI presents the two groups differently because the next
/// thing the user should do differs - reread the problem, versus fix a crash.
enum SubmissionVerdict {
  ACCEPTED
  WRONG_ANSWER
  COMPILE_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  /// The execution engine was unreachable or returned something unusable.
  /// Never the user's fault, and shown as such.
  INTERNAL_ERROR
}
