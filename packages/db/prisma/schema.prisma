generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  username       String           @unique
  passwordHash   String?
  googleId       String?          @unique
  name           String?
  avatarUrl      String?
  role           Role             @default(USER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  puzzles        Puzzle[]
  puzzleAttempts PuzzleAttempt[]
  puzzleProgress PuzzleProgress[]
  sessions       Session[]
  projects       Project[]

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BlogPost {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String    @unique
  title       String
  excerpt     String?
  coverImage  String?   @map("cover_image")
  authorName  String?   @map("author_name")
  status      String    @default("draft")
  body        Json      @default("[]")
  tags        String[]  @default([])
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([publishedAt(sort: Desc)], map: "idx_blog_posts_published_at")
  @@map("blog_posts")
}

model TutorialSection {
  id       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug     String         @unique
  title    String
  position Int            @default(0)
  pages    TutorialPage[]

  @@map("tutorial_sections")
}

model TutorialPage {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String           @unique
  title       String
  excerpt     String?
  coverImage  String?          @map("cover_image")
  authorName  String?          @map("author_name")
  status      String           @default("draft")
  body        Json             @default("[]")
  tags        String[]         @default([])
  position    Int              @default(0)
  sectionId   String?          @map("section_id") @db.Uuid
  section     TutorialSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  publishedAt DateTime?        @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([sectionId, position])
  @@map("tutorial_pages")
}

model Puzzle {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  description String?
  difficulty  Difficulty      @default(MEDIUM)
  data        Json
  solution    Json
  creatorId   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  creator     User?           @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  attempts    PuzzleAttempt[]

  @@index([creatorId])
  @@index([difficulty])
}

model PuzzleAttempt {
  id            String   @id @default(cuid())
  userId        String
  puzzleId      String
  solved        Boolean  @default(false)
  attemptsCount Int      @default(1)
  timeTakenMs   Int?
  submittedAt   DateTime @default(now())
  puzzle        Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([puzzleId])
}

model PuzzleProgress {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String
  puzzleSlug String    @map("puzzle_slug")
  solved     Boolean   @default(false)
  solvedAt   DateTime? @map("solved_at") @db.Timestamptz(6)
  nodes      Json      @default("[]")
  edges      Json      @default("[]")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, puzzleSlug])
  @@index([userId])
  @@map("puzzle_progress")
}

model Project {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         String
  nodes        Json              @default("[]")
  edges        Json              @default("[]")
  visibility   ProjectVisibility @default(PRIVATE)
  ownerId      String            @map("owner_id")
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  forkedFromId String?           @map("forked_from_id")
  forkedFrom   Project?          @relation("ProjectForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks        Project[]         @relation("ProjectForks")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([visibility])
  @@map("projects")
}

enum ProjectVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}
