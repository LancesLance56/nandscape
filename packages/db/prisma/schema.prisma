generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  username                String                   @unique
  passwordHash            String?
  googleId                String?                  @unique
  /** Null until the address is confirmed via the emailed verification link
   *  (or, for Google sign-in, immediately set at creation when Google
   *  already reports the address verified - see findOrCreateGoogleUser). */
  emailVerifiedAt         DateTime?
  name                    String?
  avatarUrl               String?
  role                    Role                     @default(USER)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  puzzles                 Puzzle[]
  puzzleAttempts          PuzzleAttempt[]
  puzzleProgress          PuzzleProgress[]
  sessions                Session[]
  projects                Project[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([email])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BlogPost {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String    @unique
  title       String
  excerpt     String?
  coverImage  String?   @map("cover_image")
  authorName  String?   @map("author_name")
  status      String    @default("draft")
  body        Json      @default("[]")
  tags        String[]  @default([])
  /** The <title> tag, which wants ~50-60 characters and the target keyword
   *  near the front - a different job from `title`, the on-page H1, which is
   *  written for a reader already on the page. Null falls back to `title`. */
  seoTitle       String?  @map("seo_title")
  /** The meta description (~150-160 chars). Distinct from `excerpt`, which
   *  is card/listing copy; this one is written to earn the click from a
   *  search result. Null falls back to `excerpt`. */
  seoDescription String?  @map("seo_description")
  /** Target search keywords, most important first. Not emitted as the
   *  long-dead <meta keywords> tag - it's editorial intent, used to keep
   *  headings/copy honest and to fill schema.org `keywords`. */
  keywords       String[] @default([])
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([publishedAt(sort: Desc)], map: "idx_blog_posts_published_at")
  @@map("blog_posts")
}

model TutorialSection {
  id       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug     String         @unique
  title    String
  position Int            @default(0)
  pages    TutorialPage[]

  @@map("tutorial_sections")
}

model TutorialPage {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String           @unique
  title       String
  excerpt     String?
  coverImage  String?          @map("cover_image")
  authorName  String?          @map("author_name")
  status      String           @default("draft")
  body        Json             @default("[]")
  tags        String[]         @default([])
  /** See the matching fields on BlogPost for what each is for. */
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  keywords       String[]      @default([])
  position    Int              @default(0)
  sectionId   String?          @map("section_id") @db.Uuid
  section     TutorialSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  publishedAt DateTime?        @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([sectionId, position])
  @@map("tutorial_pages")
}

model Puzzle {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  description String?
  difficulty  Difficulty      @default(MEDIUM)
  data        Json
  solution    Json
  creatorId   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  creator     User?           @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  attempts    PuzzleAttempt[]

  @@index([creatorId])
  @@index([difficulty])
}

model PuzzleAttempt {
  id            String   @id @default(cuid())
  userId        String
  puzzleId      String
  solved        Boolean  @default(false)
  attemptsCount Int      @default(1)
  timeTakenMs   Int?
  submittedAt   DateTime @default(now())
  puzzle        Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([puzzleId])
}

model PuzzleProgress {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String
  puzzleSlug String    @map("puzzle_slug")
  solved     Boolean   @default(false)
  solvedAt   DateTime? @map("solved_at") @db.Timestamptz(6)
  nodes      Json      @default("[]")
  edges      Json      @default("[]")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, puzzleSlug])
  @@index([userId])
  @@map("puzzle_progress")
}

model Project {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         String
  description  String?
  /** `nodes`/`edges` always mirror `scopes[0]` (the project's first tab), so
   *  every reader that predates tabs - embeds, thumbnails, the sitemap -
   *  keeps working unchanged against a single flat circuit. */
  nodes        Json              @default("[]")
  edges        Json              @default("[]")
  /** Every tab (CircuitVerse calls these "scopes") in this project. Any tab
   *  can be dropped into another as a subcircuit instance - see
   *  apps/web/types/scope.ts and apps/web/store/scopes-store.ts. */
  scopes       Json              @default("[]")
  /** Snapshot of every non-builtin custom block this project's subcircuit
   *  nodes reference (transitively), so the project stays self-contained
   *  regardless of what's in any particular browser's local block library
   *  - see apps/web/lib/editor/subcircuit-flatten.ts's resolveBlockClosure,
   *  which computes this at save time. */
  blocks       Json              @default("[]")
  visibility   ProjectVisibility @default(PRIVATE)
  ownerId      String            @map("owner_id")
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  forkedFromId String?           @map("forked_from_id")
  forkedFrom   Project?          @relation("ProjectForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks        Project[]         @relation("ProjectForks")
  featuredIn   FeaturedCircuit[]
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([visibility])
  @@map("projects")
}

enum ProjectVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

/** Admin-curated candidates for the homepage's live-demo embed (see
 *  apps/web/components/marketing/live-demo.tsx) - marketing can add several
 *  projects here over time and switch which one is live without touching
 *  code. At most one row should have `active = true` at a time; that's
 *  enforced at the application layer (see featured-circuits.ts's
 *  setActiveFeaturedCircuit, a single atomic UPDATE that sets every row's
 *  `active` from an `id = $1` comparison), not a DB constraint, matching how
 *  simple admin toggles are handled elsewhere in this codebase. */
model FeaturedCircuit {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([active])
  @@map("featured_circuits")
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}
